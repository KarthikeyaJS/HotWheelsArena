# ─────────────────────────────────────────────────────────────────────────────
# HotWheelsArena — environment variables (copy to .env.local and fill in).
# All VITE_* values are embedded in the client bundle: never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# "true" connects Auth/Firestore/Functions to the local Emulator Suite
VITE_USE_EMULATORS=false
# Optional emulator host (defaults to 127.0.0.1)
VITE_EMULATOR_HOST=127.0.0.1

# Cloud Functions region (must match the functions deployment)
VITE_FUNCTIONS_REGION=asia-south1

# Cloudinary cloud name — leave empty to use the local SVG placeholders
VITE_CLOUDINARY_CLOUD_NAME=

# Payment provider id: "dummy" (test mode). Future: "razorpay".
VITE_PAYMENT_PROVIDER=dummy

# Firebase Analytics (only initialised when "true" and not using emulators)
VITE_ENABLE_ANALYTICS=false

# Public site URL used for canonical links / Open Graph (no trailing slash)
VITE_SITE_URL=https://hotwheelsarena.web.app
