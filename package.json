{
  "name": "hotwheelsarena",
  "private": true,
  "version": "1.0.0",
  "description": "HotWheelsArena — the Digital Collector's Garage. E-commerce + collector experience for Indian die-cast collectors.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hotwheelsarena \"vitest run -c vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-hotwheelsarena",
    "seed": "tsx scripts/seed.ts",
    "seed:emulator": "tsx scripts/seed.ts --emulator",
    "seed:verify": "tsx scripts/verify-seed.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "sounds": "node scripts/generate-sounds.mjs",
    "images": "tsx scripts/generate-images.ts",
    "images:check": "tsx scripts/generate-images.ts --check",
    "snap": "node scripts/dev/snap.mjs",
    "functions:build": "npm --prefix functions run build",
    "presmoke": "npm run functions:build",
    "smoke": "firebase emulators:exec --only auth,firestore,functions --project demo-hotwheelsarena \"npm run seed:emulator && node scripts/smoke-e2e.mjs\"",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "firebase": "~10.14.1",
    "framer-motion": "~11.18.2",
    "gsap": "~3.13.0",
    "howler": "~2.2.4",
    "lucide-react": "~0.577.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "~6.30.6",
    "tailwind-merge": "~2.6.1",
    "zod": "~3.25.76",
    "zustand": "~5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@firebase/rules-unit-testing": "~3.0.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/howler": "^2.2.12",
    "@types/node": "~22.20.4",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "~4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "~9.39.5",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.4.26",
    "firebase-admin": "~13.10.0",
    "firebase-tools": "^15.31.0",
    "globals": "^16.0.0",
    "jsdom": "~26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "~0.6.14",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "~5.4.21",
    "vitest": "~3.2.7"
  }
}
